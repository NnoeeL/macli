# ==============================================================================
# macli LLM Configuration (OpenAI-compatible endpoint)
# ==============================================================================
# Copy this file to .env (or run `macli init`) and fill in your credentials.

# Required: API key for your provider (for local Ollama, any non-empty string works, e.g., "ollama")
LLM_API_KEY=your-api-key-here

# Base URL for an OpenAI-compatible API endpoint
LLM_BASE_URL=https://api.groq.com/openai/v1

# Model name supported by your provider
LLM_MODEL=llama-3.3-70b-versatile

# Optional settings
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT=120

# ==============================================================================
# Provider Presets (uncomment the one you want to use)
# ==============================================================================

# --- Groq (Free tier, very fast) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# --- Google Gemini (OpenAI-compatible endpoint) ---
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_MODEL=gemini-2.0-flash

# --- OpenRouter (Many free & paid models) ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Ollama (100% Local, Free) ---
# LLM_API_KEY=ollama
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b

# --- OpenAI ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
